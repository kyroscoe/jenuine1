<div class="product-grid">
  {% assign shown_products = 0 %}

  {% for product in collections.all.products limit: 12 %}
    {% if shown_products < 6 %}
      {% assign shown_products = shown_products | plus: 1 %}
      <article class="product-card">
        <a href="{{ product.url }}">
          <div>
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 700 | image_tag: alt: product.title, loading: 'lazy', width: 533, height: 533 }}
            {% else %}
              <div class="product-placeholder">{{ product.title | slice: 0, 2 }}</div>
            {% endif %}
          </div>
          <section>
            <p>{% if product.collections.first %}{{ product.collections.first.title }}{% else %}Shop{% endif %}</p>
            <h3>{{ product.title }}</h3>
            <strong>{% if product.price_varies %}From {% endif %}{{ product.price_min | money }}</strong>
          </section>
        </a>
      </article>
    {% endif %}
  {% endfor %}

  {% if shown_products == 0 %}
    <article class="product-card">
      <div><div class="product-placeholder">JD</div></div>
      <section>
        <p>Products</p>
        <h3>No products available yet</h3>
        <strong>Add products in Shopify admin</strong>
      </section>
    </article>
  {% endif %}
</div>
