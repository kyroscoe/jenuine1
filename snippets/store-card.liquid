<article class="store-card" data-category="shopify">
  <a class="store-logo" href="{{ collection.url }}">
    {% if collection.image %}
      {{ collection.image | image_url: width: 700 | image_tag: alt: collection.title, loading: 'lazy', width: 400, height: 300 }}
    {% elsif collection.products.first.featured_image %}
      {{ collection.products.first.featured_image | image_url: width: 700 | image_tag: alt: collection.title, loading: 'lazy', width: 400, height: 300 }}
    {% else %}
      <div class="product-placeholder">{{ collection.title | slice: 0, 2 }}</div>
    {% endif %}
  </a>
  <div class="store-body">
    <div class="card-title-row">
      <h3><a href="{{ collection.url }}">{{ collection.title }}</a></h3>
      <span>{{ collection.products.size }} items</span>
    </div>
    {% if collection.description != blank %}
      <p>{{ collection.description | strip_html | truncate: 160 }}</p>
    {% else %}
      <p>Shop available products in the {{ collection.title }} collection.</p>
    {% endif %}

    <div class="product-list">
      <p>Available products</p>
      {% if collection.products.size > 0 %}
        <ul>
          {% for product in collection.products limit: 4 %}
            <li>
              <a href="{{ product.url }}">{{ product.title }}</a>
              <span>{% if product.price_varies %}From {% endif %}{{ product.price_min | money }}</span>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="muted">Products coming soon for this collection.</p>
      {% endif %}
    </div>
  </div>
</article>
