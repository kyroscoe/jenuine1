{% liquid
  assign collection_menu_handle = menu_handle | default: blank
  assign collection_menu = linklists[collection_menu_handle]
  assign shown_collections = 0
%}

<div class="store-grid">
  {% if collection_menu.links.size > 0 %}
    {% for link in collection_menu.links %}
      {% if link.type == 'collection_link' and link.object != blank %}
        {% assign collection = link.object %}
        {% assign shown_collections = shown_collections | plus: 1 %}
        {% render 'store-card', collection: collection %}
      {% endif %}
    {% endfor %}
  {% else %}
    {% for collection in collections %}
      {% unless collection.handle == 'frontpage' or collection.handle == 'all' %}
        {% assign shown_collections = shown_collections | plus: 1 %}
        {% render 'store-card', collection: collection %}
      {% endunless %}
    {% endfor %}
  {% endif %}

  {% if shown_collections == 0 %}
    <article class="store-card" data-category="shopify">
      <div class="store-body">
        <div class="card-title-row"><h3>No collections yet</h3><span>setup</span></div>
        {% if collection_menu_handle != blank %}
          <p>Add collection links to the Shopify navigation menu with handle <strong>{{ collection_menu_handle }}</strong>. They will appear here automatically.</p>
        {% else %}
          <p>Create Shopify collections and add products to them. They will appear here automatically.</p>
        {% endif %}
      </div>
    </article>
  {% endif %}
</div>
