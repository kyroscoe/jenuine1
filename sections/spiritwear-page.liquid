<section class="page-hero">
  <div class="page-width">
    <p class="eyebrow">Spiritwear</p>
    <h1>Spiritwear That Builds Community.</h1>
    <p>Show your pride with custom-designed apparel for schools, teams, and organizations.</p>
  </div>
</section>

<section class="section">
  <div class="page-width">
    <div class="store-grid spiritwear-grid">
      <article class="store-card">
        <div class="store-logo"><img src="{{ 'northeastern-jets.webp' | asset_url }}" alt="Northeastern Jets" width="400" height="300"></div>
        <div class="store-body"><h2>Northeastern Jets</h2><p>School spiritwear and team apparel for Jets supporters.</p></div>
      </article>
      <article class="store-card">
        <div class="store-logo"><img src="{{ 'ohio-legends.webp' | asset_url }}" alt="Ohio Legends Volleyball Club" width="400" height="300"></div>
        <div class="store-body"><h2>Ohio Legends Volleyball Club</h2><p>Club volleyball spiritwear for athletes, families, and fans.</p></div>
      </article>
    </div>
  </div>
</section>

<section class="section section-white">
  <div class="page-width">
    <p class="eyebrow">Featured spiritwear products</p>
    {% render 'featured-products' %}
  </div>
</section>

<section class="section">
  <div class="page-width">
    <div class="cta-panel cta-dark">
      <div>
        <p class="eyebrow">Need a spiritwear store?</p>
        <h2>Launch a dedicated school or team store.</h2>
        <p>Use one organized storefront per school, team, or organization so families and supporters can actually find the right gear.</p>
      </div>
      <a class="button button-inverse" href="/pages/contact">Start a spiritwear store</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Spiritwear page",
  "settings": [],
  "presets": [{ "name": "Spiritwear page" }]
}
{% endschema %}
