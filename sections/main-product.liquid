<section class="section">
  <div class="page-width product-detail">
    <div class="product-media">
      {% if product.images.size > 0 %}
        {% assign featured_product_image = product.featured_image | default: product.images.first %}
        {% assign featured_image_alt = featured_product_image.alt | default: product.title %}
        <div class="product-gallery" data-product-gallery>
          <div class="product-gallery-main">
            <img
              src="{{ featured_product_image | image_url: width: 1000 }}"
              alt="{{ featured_image_alt | escape }}"
              width="700"
              height="700"
              loading="eager"
              data-main-image
            >
          </div>

          {% if product.images.size > 1 %}
            <div class="product-gallery-thumbnails" aria-label="Product images">
              {% for image in product.images %}
                {% assign image_alt = image.alt | default: product.title %}
                <button
                  class="product-gallery-thumbnail{% if image.id == featured_product_image.id %} is-active{% endif %}"
                  type="button"
                  aria-label="Show image {{ forloop.index }} of {{ product.images.size }}"
                  aria-current="{% if image.id == featured_product_image.id %}true{% else %}false{% endif %}"
                  data-gallery-thumbnail
                  data-full-image="{{ image | image_url: width: 1000 }}"
                  data-image-alt="{{ image_alt | escape }}"
                >
                  {{ image | image_url: width: 180 | image_tag: alt: image_alt, width: 90, height: 90, loading: 'lazy' }}
                </button>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% else %}
        <div class="product-placeholder large">{{ product.title | slice: 0, 2 }}</div>
      {% endif %}
    </div>

    <div class="product-summary">
      {% if product.collections.first %}
        <p class="eyebrow">{{ product.collections.first.title }}</p>
      {% endif %}
      <h1>{{ product.title }}</h1>
      <p class="product-price">
        {% if product.price_varies %}From {% endif %}{{ product.price_min | money }}
      </p>

      {% if product.description != blank %}
        <div class="rte product-description">{{ product.description }}</div>
      {% endif %}

      {% form 'product', product, class: 'product-form' %}
        {% if product.has_only_default_variant %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {% else %}
          <label>
            Options
            <select name="id">
              {% for variant in product.variants %}
                <option
                  value="{{ variant.id }}"
                  {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {{ variant.title }} - {{ variant.price | money }}{% unless variant.available %} - Sold out{% endunless %}
                </option>
              {% endfor %}
            </select>
          </label>
        {% endif %}

        <label>
          Quantity
          <input type="number" name="quantity" value="1" min="1">
        </label>

        <button class="button button-primary" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
          {% if product.selected_or_first_available_variant.available %}Add to cart{% else %}Sold out{% endif %}
        </button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main product",
  "settings": []
}
{% endschema %}
