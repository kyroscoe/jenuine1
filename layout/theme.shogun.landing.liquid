{% comment %}
Auto-generated by Shogun.
This file can be re-written at any time.
{% endcomment %}

{% include 'shogun-content-handler' %}
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="JENuine Designs creates custom apparel, uniforms, spiritwear, and branded online stores for schools, teams, businesses, farms, and organizations.">
    {% endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.0.0/fonts/remixicon.css" rel="stylesheet">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    {% include 'shogun-content-handler' %}

    
    
    {{ content_for_layout }}
    
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <style type="text/css">
      body, html {
        width: 100% !important;
        background: white !important;
      }
    </style>
    
  </body>
</html>
